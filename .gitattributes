# Normalize text files for consistent diffs across Unity, macOS, and CI.
* text=auto eol=lf

# Unity/package source and serialized YAML assets stay reviewable in Git.
*.asmdef text eol=lf
*.asmref text eol=lf
*.cs text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.cginc text eol=lf

# Binary/media assets are stored directly in Git so Unity Package Manager Git
# installs do not require Git LFS on consumer machines.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.ttf binary
*.otf binary
*.fbx binary
*.blend binary
*.glb binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.unitypackage binary
